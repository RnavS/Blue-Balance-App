# Postgres connection string. Works with any provider: Neon, Railway, Render,
# Fly Postgres, RDS, or local Docker.
#   local:  postgres://postgres:postgres@localhost:5432/blue_balance
DATABASE_URL=

# Signing key for access tokens. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=

# Optional
PORT=8787
NODE_ENV=development
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=60
# Comma-separated allowlist. Leave empty to allow any origin (fine for a native app).
CORS_ORIGINS=

# AI coach
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe (web/Android billing; iOS is free in 1.0)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_ANNUAL_PRICE_ID=

# Optional third barcode provider; the first two need no key.
GO_UPC_API_KEY=

# Set to "false" to re-enable the paywall on iOS.
IOS_PREMIUM_FREE=true
