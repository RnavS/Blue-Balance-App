# =============================================================================
# Blue Balance API
#
# Copy to .env and paste your values in. `npm run dev` does the copy for you.
# This file is committed; .env is gitignored — never put a real key here.
#
# EVERYTHING BELOW IS OPTIONAL. With none of it the server still runs: embedded
# Postgres, a generated dev signing key, migrations applied on boot. Fill in only
# what you want to switch on.
# =============================================================================


# --- AI coach ----------------------------------------------------------------
# Any endpoint speaking OpenAI's /chat/completions shape works: your own model,
# a self-hosted server (vLLM, Ollama, LM Studio, TGI), or OpenAI itself.
# Leave blank and the coach returns 500 — everything else keeps working.

# Root that has /chat/completions under it; the server appends that path.
#   your own : https://your-ai-host.com/v1
#   Ollama   : http://localhost:11434/v1
#   OpenAI   : https://api.openai.com/v1
AI_BASE_URL=

AI_API_KEY=

# Exact id your provider expects. Ask it:  curl $AI_BASE_URL/models -H "Authorization: Bearer $AI_API_KEY"
AI_MODEL=


# --- Password reset email ----------------------------------------------------
# Without both, POST /auth/reset-password returns 503 in production instead of
# claiming to have sent something. Free tier at resend.com; EMAIL_FROM must be
# on a domain verified there.

RESEND_API_KEY=
EMAIL_FROM=


# --- Database ----------------------------------------------------------------
# Blank uses embedded Postgres at server/pgdata — nothing to install.
# REQUIRED in production; the server refuses to start without it.
#   any provider: Neon, Railway, Render, Fly, RDS
#   local Docker: postgres://postgres:postgres@localhost:5432/blue_balance

DATABASE_URL=

# Blank generates one and saves it to server/.dev-secret.
# REQUIRED in production. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=


# --- Billing -----------------------------------------------------------------
# Only for web/Android. iOS is free in 1.0, so these can stay blank to ship.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_ANNUAL_PRICE_ID=


# --- Barcode -----------------------------------------------------------------
# Third lookup provider. The first two (Open Food Facts, UPCItemDB) need no key.

GO_UPC_API_KEY=


# --- Everything else has a working default -----------------------------------

# PORT=8787
# NODE_ENV=development
# ACCESS_TOKEN_TTL_SECONDS=3600
# REFRESH_TOKEN_TTL_DAYS=60
# CORS_ORIGINS=                 comma-separated; blank allows any origin
# IOS_PREMIUM_FREE=true         "false" re-enables the iOS paywall
# SKIP_AUTO_MIGRATE=false       "true" to run migrations yourself
