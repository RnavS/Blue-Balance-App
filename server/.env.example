# Postgres connection string. Works with any provider: Neon, Railway, Render,
# Fly Postgres, RDS, or local Docker.
#   local:  postgres://postgres:postgres@localhost:5432/blue_balance
DATABASE_URL=

# Signing key for access tokens. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=

# Optional
PORT=8787
NODE_ENV=development
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=60
# Comma-separated allowlist. Leave empty to allow any origin (fine for a native app).
CORS_ORIGINS=

# AI coach
# --- AI coach -----------------------------------------------------------------
# Works with any endpoint that speaks the OpenAI chat-completions shape:
# your own model, a self-hosted server (vLLM, Ollama, LM Studio, TGI), or OpenAI.
#
# AI_BASE_URL is the root that has /chat/completions under it — the server
# appends that path itself.
#   your own API : https://your-ai-host.com/v1
#   Ollama local : http://localhost:11434/v1
#   OpenAI       : https://api.openai.com/v1   (the default)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# If your model does not speak that shape, the request lives in exactly one
# place: the /ai-coach route in server/src/routes/functions.ts.

# Stripe (web/Android billing; iOS is free in 1.0)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_ANNUAL_PRICE_ID=

# Optional third barcode provider; the first two need no key.
GO_UPC_API_KEY=

# Password reset email. Without both of these, POST /auth/reset-password returns
# 503 in production rather than claiming to have sent something.
# Free tier at resend.com; EMAIL_FROM must be on a domain you verified there.
RESEND_API_KEY=
EMAIL_FROM=Blue Balance <noreply@yourdomain.com>

# Set to "false" to re-enable the paywall on iOS.
IOS_PREMIUM_FREE=true
