# Where the app looks for the Blue Balance API.
#
# Leave this commented out for local development. A dev build works it out on
# its own: it asks Expo which machine is serving the JS bundle and uses port
# 8787 on that same host. That is correct in the simulator *and* on a physical
# device on your Wi-Fi, whereas a hardcoded "localhost" would be wrong on the
# device — the phone's localhost is the phone.
#
# Set it only when pointing at a deployed backend, or when building for release
# (a release build has no dev server to ask, so it is required there).
#
# EXPO_PUBLIC_API_URL=https://your-api-host.com

# Scandit barcode SDK. Without it the scanner falls back to expo-camera.
EXPO_PUBLIC_SCANDIT_LICENSE_KEY=
