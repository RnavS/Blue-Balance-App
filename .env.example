# Blue Balance API (server/). Point this at your deployed backend.
# Local development:
#   - iOS simulator / web:  http://localhost:8787
#   - Android emulator:     http://10.0.2.2:8787
#   - Physical device:      http://<your-lan-ip>:8787
EXPO_PUBLIC_API_URL=http://localhost:8787

# Scandit barcode SDK. Without it the scanner falls back to expo-camera.
EXPO_PUBLIC_SCANDIT_LICENSE_KEY=
